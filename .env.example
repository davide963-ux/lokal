# ─────────────────────────────────────────────────────────────
# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.
# One deployment == one restaurant == one database.
# ─────────────────────────────────────────────────────────────

# Pooled PostgreSQL connection used by the running app (serverless-safe).
# Neon / Vercel Postgres: use the "pooled" connection string (host contains -pooler).
# Supabase: use the transaction pooler (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/DBNAME?sslmode=require"

# Direct (non-pooled) connection used ONLY by `prisma migrate`.
# If omitted, DATABASE_URL is used for migrations as well.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of this deployment, e.g. https://trattoria-rossi.vercel.app
AUTH_URL="http://localhost:3000"
# On Vercel set to "true" (Auth.js trusts the platform's forwarded host header).
AUTH_TRUST_HOST="true"

# Vercel Blob (dish photos, restaurant logo). Created via Vercel → Storage → Blob.
BLOB_READ_WRITE_TOKEN=""

# Used only by `npm run setup:admin` (first-deployment admin creation).
# Leave blank to be prompted interactively. Never commit real values.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
