  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "setup:admin": "tsx scripts/create-admin.ts",
    "vercel-build": "node scripts/check-build-env.mjs && prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "audit:pages": "node scripts/audit-pages.cjs"
  },
